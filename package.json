{
  "name": "cineflow",
  "version": "1.0.0",
  "description": "Autonomous AI Video Studio & Programmatic Video Editor powered by Remotion",
  "private": false,
  "scripts": {
    "sync": "node scripts/sync-videos.mjs",
    "studio": "node scripts/sync-videos.mjs && remotion studio",
    "render": "node scripts/sync-videos.mjs && remotion render",
    "still": "node scripts/sync-videos.mjs && remotion still",
    "compositions": "node scripts/sync-videos.mjs && remotion compositions",
    "inspect": "node scripts/inspect-video.mjs",
    "generate-sfx": "node scripts/generate-sfx.mjs",
    "typecheck": "node scripts/sync-videos.mjs && tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "@remotion/media-utils": "^4.0.543",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0",
    "simple-icons": "^13.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "typescript": "^5.5.0"
  }
}
